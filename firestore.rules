rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    // Admin = e-mail VERIFICADO desta lista (a mesma de src/admins.js)
    // ou um documento admins/{uid} criado à mão no console do Firebase.
    function admin() {
      return logado() && (
        (request.auth.token.email_verified == true
          && request.auth.token.email in ['bedimjoaovictor@gmail.com', 'bobapromo@gmail.com'])
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Destaques escolhidos a dedo: a vitrine é pública; só o admin destaca, atualiza e remove
    match /destaques/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Rodízio de destaques: métrica escolhida e jogos destacados há pouco (para não repetir)
    match /config/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Catálogo "Games": todo jogo que já apareceu em promoção. Público para leitura.
    // Usuários logados gravam os jogos que veem, mas só com estes campos e tipos.
    function jogoValido(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['gameID', 'titulo', 'imagem', 'steamAppID', 'lojaId', 'ultimoPreco',
                               'ultimoPrecoNormal', 'ultimoDesconto', 'ultimaPromocaoEm'])
        && d.gameID == id
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() < 200
        && d.imagem is string && d.imagem.size() < 500
        && (!('steamAppID' in d) || (d.steamAppID is string && d.steamAppID.size() < 13))
        && d.lojaId is string && d.lojaId.size() < 5
        && d.ultimoPreco is number && d.ultimoPrecoNormal is number && d.ultimoDesconto is number
        && d.ultimaPromocaoEm == request.time;
    }
    match /jogos/{id} {
      allow read: if true;
      allow create, update: if admin() || (logado() && jogoValido(id));
      allow delete: if admin();
    }

    // Recomendações diárias: só para usuários logados; só o admin mexe
    match /recomendacoes/{id} {
      allow read: if logado();
      allow create, update, delete: if admin();
    }

    // Lista de admins: cada um só consegue ler o próprio documento; ninguém grava pelo app
    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Perfil e jogos seguidos: cada usuário só acessa os próprios dados
    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;

      match /seguindo/{gameId} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }
  }
}
