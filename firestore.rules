rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    // Admin = existe admins/{uid}. Crie esse documento à mão no console do Firebase.
    function admin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Promoções aprovadas: a vitrine é pública; só o admin aprova, atualiza e remove
    match /promocoes/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Jogos que já estiveram em oferta: lista usada no Notificar
    match /jogos/{id} {
      allow read: if logado();
      allow create, update, delete: if admin();
    }

    // Recomendações diárias: só para usuários logados; só o admin mexe
    match /recomendacoes/{id} {
      allow read: if logado();
      allow create, update, delete: if admin();
    }

    // Lista de admins: cada um só consegue ler o próprio documento; ninguém grava pelo app
    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Perfil e jogos seguidos: cada usuário só acessa os próprios dados
    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;

      match /seguindo/{gameId} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }
  }
}
